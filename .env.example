# Frontend (publishable only)
# Dashboard → API Keys. If sb_publishable_ returns 401, use legacy anon JWT (eyJ…).
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PRIVY_APP_ID=
# Set true only after Privy Dashboard has Google OAuth enabled + domains allowlisted
# VITE_PRIVY_GOOGLE_ENABLED=true

# Server / Edge Function secrets — NEVER use VITE_ prefix
# Prefer sb_secret_… ; legacy service_role JWT also works for edge secrets.
SUPABASE_SECRET_KEY=
NARDOPAY_API_KEY=
NARDOPAY_API_URL=https://mczqwqsvumfsneoknlep.supabase.co/functions/v1/create-payment-link-api
# Must match NardoPay project webhook secret (no hardcoded default in prod)
NARDOPAY_WEBHOOK_SECRET=
PUBLIC_APP_URL=https://twen.app
# App subdomains (same Vercel project): creator.twen.app, brand.twen.app, admin.twen.app
# Landings stay on apex: https://twen.app/creators , https://twen.app/brands
# Allowlist origins in Privy:
#   ./scripts/privy-set-domains.sh https://twen.app https://creator.twen.app https://brand.twen.app https://admin.twen.app
# ALLOW_LOCAL_CHECKOUT=true   # only for local edge checkout while PUBLIC_APP_URL is localhost
PRIVY_APP_ID=
PRIVY_APP_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL="Twen <onboarding@resend.dev>"
CONTACT_TO_EMAIL="hello@twen.app"
PAYOUT_OPS_EMAIL="hello@twen.app"
# View verification (edge) — omit all = fail closed (no simulated earnings)
# TikTok Login Kit redirect URIs:
#   http://localhost:8080/auth/social-callback
#   https://twen.app/auth/social-callback
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_ACCESS_TOKEN=
# Instagram Graph (Meta): long-lived token that can read media insights
# INSTAGRAM_ACCESS_TOKEN=
# Optional IG user id for permalink matching when oEmbed has no media_id
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Creator Instagram Login (connect account on profile) — same redirect URIs as TikTok
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# Didit ID verification (https://business.didit.me) — omit = staff review only
# DIDIT_API_KEY=
# ALLOW_SIMULATED_VIEWS=false
PRO_PLAN_AMOUNT=49
# Scheduled verify-views caller (Bearer token)
CRON_SECRET=
